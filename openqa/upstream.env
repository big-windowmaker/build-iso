# Harness openQA da BigLinux usado pelo teste de instalação (lido por
# scripts/install-test.sh e pelo job install-test do workflow).
#
# UPSTREAM_SHA: commit de biglinux/iso-profiles cujos openqa/ e data/ são
# usados, com os patches de openqa/patches/ e o overlay de openqa/overlay/.
# Ao atualizar, rode o teste localmente: os patches são aplicados sem fuzz e
# falham se o trecho mudou. Mesmo commit do ENGINE_SHA do build-iso.yml.
UPSTREAM_REPO=biglinux/iso-profiles
UPSTREAM_SHA=8ec5ad1f861156055a35bcf3a82702178d319c8a

# Imagem do isotovideo (os-autoinst), fixada por digest. A BigLinux usa um
# espelho privado em ghcr.io/biglinux; o digest dela
# (sha256:d30661a2cf68...) já foi removido do registry do openSUSE, que
# guarda poucas versões. Esta é a openqa-single-instance
# 5.1792772346.47.14.299 (os-autoinst 5.1792683987, QEMU 11.1.2), baixada e
# usada no teste local em 2026-10-26. Se o digest sumir, escolha outro com:
#   curl -s https://registry.opensuse.org/v2/devel/openqa/containers/opensuse/openqa-single-instance/tags/list
#   curl -sI -H 'Accept: application/vnd.docker.distribution.manifest.list.v2+json' \
#     https://registry.opensuse.org/v2/devel/openqa/containers/opensuse/openqa-single-instance/manifests/<tag> \
#     | grep -i docker-content-digest
OPENQA_IMAGE=registry.opensuse.org/devel/openqa/containers/opensuse/openqa-single-instance@sha256:87bc93aa555fbf25249d6b93e94598c4d550455e9304076be872b2111aaf0ebd
