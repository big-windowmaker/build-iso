Date: Mon, 26 Oct 2026 01:59:56 -0300
Subject: [PATCH 3/5] =?UTF-8?q?openqa:=20sess=C3=A3o=20X11=20esperada=20co?=
 =?UTF-8?q?m=20BIGLINUX=5FSESSION=5FTYPE=3Dx11?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 data/desktop_session.py | 25 +++++++++++++++++++------
 openqa/lib/atspi.pm     |  5 ++++-
 2 files changed, 23 insertions(+), 7 deletions(-)

diff --git a/data/desktop_session.py b/data/desktop_session.py
index f43ada4..56407de 100644
--- a/data/desktop_session.py
+++ b/data/desktop_session.py
@@ -68,12 +68,25 @@ def display_ready(environment: dict[str, str], runtime: Path, deadline: float) -
         raise SessionPending("desktop identity has not been published")
     # The gate tests the Wayland session: BigLinux is dropping X11 sessions,
     # while X11 programs keep running through Xwayland inside this one.
-    wayland = environment.get("WAYLAND_DISPLAY")
-    if not wayland or environment.get("XDG_SESSION_TYPE", "wayland") != "wayland":
-        raise SessionPending("the desktop session is not a Wayland session")
-    endpoint = Path(wayland)
-    if not endpoint.is_absolute():
-        endpoint = runtime / endpoint
+    # Big WindowMaker: OPENQA_SESSION_TYPE=x11 (set by atspi.pm from the job
+    # setting BIGLINUX_SESSION_TYPE) expects an X11 session instead, and then
+    # a Wayland one is the failure.
+    if os.environ.get("OPENQA_SESSION_TYPE", "wayland") == "x11":
+        display = environment.get("DISPLAY", "")
+        if (environment.get("WAYLAND_DISPLAY") or not display.startswith(":")
+                or environment.get("XDG_SESSION_TYPE", "x11") != "x11"):
+            raise SessionPending("the desktop session is not an X11 session")
+        number = display[1:].split(".", 1)[0]
+        if not number.isdigit():
+            raise SessionPending("the X11 display is not a local display")
+        endpoint = Path(f"/tmp/.X11-unix/X{number}")
+    else:
+        wayland = environment.get("WAYLAND_DISPLAY")
+        if not wayland or environment.get("XDG_SESSION_TYPE", "wayland") != "wayland":
+            raise SessionPending("the desktop session is not a Wayland session")
+        endpoint = Path(wayland)
+        if not endpoint.is_absolute():
+            endpoint = runtime / endpoint
     authority = environment.get("XAUTHORITY")
     if authority and not os.access(authority, os.R_OK):
         raise SessionPending("desktop authentication is not ready")
diff --git a/openqa/lib/atspi.pm b/openqa/lib/atspi.pm
index d386924..aa435c8 100644
--- a/openqa/lib/atspi.pm
+++ b/openqa/lib/atspi.pm
@@ -124,7 +124,10 @@ sub reset_baseline {
     my $ready = $class->run_command(
         'curl --fail --silent --show-error --max-time 15 ' . shell_quote($session_url)
           . ' --output /tmp/openqa-desktop-session.py && '
-          . 'session_environment=$(python3 /tmp/openqa-desktop-session.py --timeout 90) && '
+          # Big WindowMaker: the session type the job expects (wayland by default).
+          . 'session_environment=$(OPENQA_SESSION_TYPE='
+          . shell_quote(get_var('BIGLINUX_SESSION_TYPE', 'wayland'))
+          . ' python3 /tmp/openqa-desktop-session.py --timeout 90) && '
           . 'eval "$session_environment"', 120);
     die 'the desktop session did not become ready; no accessibility repair was attempted'
       unless defined $ready && $ready == 0;
