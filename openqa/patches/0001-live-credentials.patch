---
 openqa/lib/biglinux.pm | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/openqa/lib/biglinux.pm b/openqa/lib/biglinux.pm
index c86fe11..562daba 100644
--- a/openqa/lib/biglinux.pm
+++ b/openqa/lib/biglinux.pm
@@ -42,7 +42,10 @@ sub activate_console ($self, $console, @) {
     # the freshly installed system, not just for a getty to respawn.
     defined testapi::wait_serial('login:', timeout => 180)
       or die 'serial console did not show a login prompt';
-    my ($user, $password) = ('biglinux', 'biglinux');
+    # Big WindowMaker: the live account is a job setting (BigCommunity uses
+    # community/big); the defaults keep BigLinux's own live account.
+    my ($user, $password) = (testapi::get_var('BIGLINUX_LIVE_USER', 'biglinux'),
+        testapi::get_var('BIGLINUX_LIVE_PASSWORD', 'biglinux'));
     if ($mode eq 'installed') {
         $user = testapi::get_required_var('BIGLINUX_TEST_USER');
         $password = biglinux->test_password;
@@ -133,7 +136,7 @@ sub become_root {
 
     my $password = $credentials eq 'installed'
       ? biglinux->test_password
-      : 'biglinux';
+      : testapi::get_var('BIGLINUX_LIVE_PASSWORD', 'biglinux');
     my $prompt_marker = '__OA_SUDO_PASSWORD__';
     my $prompt_format = marker_format($prompt_marker);
     my $done_marker = '__OA_SUDO_DONE__';
